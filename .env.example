# Copy to .env in the project root and fill your actual endpoint and API key.
# Include /v1, but do not include /embeddings. Never commit .env.
# Values in .env take priority over old terminal exports.
EMBEDDING_BASE_URL=https://YOUR-NGROK-DOMAIN/v1
VLLM_API_KEY=

# LLM chat API (ViLao)
LLM_BASE_URL=https://api.vilao.ai/v1
LLM_MODEL=chib/deepseek-v4.1-flash
LLM_API_KEY=
